# Backend-specific ignores. The root .gitignore covers the rest.

__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Virtual environments
venv/
.venv/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Secrets — .env.example documents every variable.
.env
.env.*
!.env.example

# Local database
*.db
*.db-wal
*.db-shm

# The King County dataset is not redistributed; see the README.
data/raw/*.csv
data/processed/*.csv
!data/**/.gitkeep

# NOTE: models/*.pkl are tracked deliberately (~1.9 MB). Shipping them lets a
# fresh clone predict immediately without downloading the dataset first.
# Regenerate with: python scripts/train_model.py
