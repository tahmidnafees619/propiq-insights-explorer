# PropIQ backend configuration.
# Copy to .env and adjust as needed. Every value below is a default.

# --- Application ---
APP_NAME=PropIQ Backend
APP_VERSION=1.1.0
# DEBUG=true switches logs from JSON to human-readable and marks the
# environment as "development" in /api/health.
DEBUG=false
LOG_LEVEL=INFO

# --- Storage (relative paths resolve against the backend root) ---
DATABASE_URL=sqlite:///./data/propiq.db
MODEL_PATH=./models/model.pkl
SCALER_PATH=./models/scaler.pkl
FEATURES_PATH=./models/feature_columns.pkl
METRICS_PATH=./models/metrics.json

# --- HTTP ---
# Comma-separated list of origins allowed to call the API.
# 5174 is included because Vite auto-increments the port when 5173 is already
# taken by another project; without it the browser blocks every API call.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174,http://localhost:3000
# Additionally allow any origin matching this regex. Empty by default.
# The pattern below covers private LAN addresses, so the app can be opened
# from a phone on the same network for testing. Leave this unset anywhere
# the API is reachable from outside the machine.
ALLOWED_ORIGIN_REGEX=
API_PREFIX=/api

# --- Behaviour ---
# When the properties table is empty, serve the curated demo dataset so the
# dashboard is never blank. Set to false to return real data only.
ENABLE_DEMO_FALLBACK=true
