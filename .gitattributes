# Normalise line endings so a Windows checkout does not produce a diff of
# every line, and so Prettier's LF expectation holds on every machine.
* text=auto eol=lf

# Binary artifacts: never touched by newline normalisation.
*.png    binary
*.jpg    binary
*.ico    binary
*.pkl    binary
*.db     binary
*.csv    text eol=lf

# Generated — collapsed in diffs and excluded from language statistics.
src/routeTree.gen.ts  linguist-generated=true
bun.lock              linguist-generated=true
package-lock.json     linguist-generated=true
