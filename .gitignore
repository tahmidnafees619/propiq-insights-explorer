# ---------- Secrets ----------
# Never commit real configuration. .env.example documents every variable.
.env
.env.*
!.env.example

# ---------- Data & model artifacts ----------
# The King County dataset is not redistributed here; see the README.
*.db
*.db-wal
*.db-shm
propiq-backend/data/raw/*.csv
propiq-backend/data/processed/*
!propiq-backend/data/**/.gitkeep

# Trained artifacts ARE tracked (~1.9 MB total). Shipping them means a fresh
# clone can predict immediately without downloading the dataset first, and
# metrics.json is what the UI reads its published accuracy figures from.
# Regenerate any time with: python scripts/train_model.py

